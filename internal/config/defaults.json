{
  "listen": "127.0.0.1:8080",
  "data_dir": "./reviewd-data",
  "app_id": 0,
  "private_key_file": "./github-app.pem",
  "webhook_secret_env": "REVIEWD_WEBHOOK_SECRET",
  "harnesses": {
    "codex": {
      "image": "reviewd-codex:local",
      "model": "gpt-5.6-luna",
      "network": "bridge",
      "credentials": [
        "codex_account"
      ],
      "driver": "github.com/jklq/reviewd/harness/codex",
      "reasoning_effort": "high"
    },
    "codex_xhigh": {
      "image": "reviewd-codex:local",
      "model": "gpt-5.6-luna",
      "network": "bridge",
      "credentials": [
        "codex_account"
      ],
      "driver": "github.com/jklq/reviewd/harness/codex",
      "reasoning_effort": "xhigh"
    },
    "codex_max": {
      "image": "reviewd-codex:local",
      "model": "gpt-5.6-luna",
      "network": "bridge",
      "credentials": [
        "codex_account"
      ],
      "driver": "github.com/jklq/reviewd/harness/codex",
      "reasoning_effort": "max"
    }
  },
  "reviewers": [
    "codex"
  ],
  "parallelism": 1,
  "validator": "codex",
  "size_tiers": [
    {
      "name": "small",
      "max_lines": 500,
      "reviewers": [
        "codex"
      ],
      "validator": "codex"
    },
    {
      "name": "medium",
      "max_lines": 2000,
      "reviewers": [
        "codex_xhigh"
      ],
      "validator": "codex_xhigh"
    },
    {
      "name": "large",
      "reviewers": [
        "codex_max"
      ],
      "validator": "codex_max"
    }
  ],
  "workers": 2,
  "timeout": "45m",
  "memory": "2g",
  "cpus": "2",
  "max_findings": 20,
  "min_finding_confidence": 0.85,
  "policy": "",
  "allow_forks": false,
  "credentials": {
    "codex_account": {
      "state_file": "./credentials/codex/auth.json",
      "env": [
        "SSL_CERT_FILE",
        "SSL_CERT_DIR",
        "CODEX_CA_CERTIFICATE",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY"
      ],
      "exports": [
        "CODEX_AUTH_JSON"
      ],
      "command": [
        "reviewd-credential-codex"
      ]
    }
  }
}
